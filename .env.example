# ============================================
# Genna Content Machine — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets!
# ============================================

# === OpenAI (GPT-4o) ===
OPENAI_API_KEY=sk-your-key-here

# === Google AI (Gemini Flash) ===
GOOGLE_API_KEY=your-google-ai-key-here

# === Paths ===
POST_STORAGE_PATH=./Post Storage
METRICS_CSV_PATH=./Metrics/genna_export.csv
FEATURES_CACHE_PATH=./data/features_cache
OUTPUT_PATH=./data/processed

# === Instagram Profile ===
INSTAGRAM_PROFILE=your_profile
